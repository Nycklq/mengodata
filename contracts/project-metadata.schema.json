    "scope": { "$ref": "urn:flamengo-analytics:manifest:2#/properties/scope" },
    "label": { "type": "string", "minLength": 1 },
    "source_status": { "const": "pending" },
    "data_status": { "const": "unavailable" },
    "dataset_version": { "type": "null" },
    "coverage": { "type": "null" }
  }
}
