  "$id": "urn:flamengo-analytics:metadata:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "label",
    "source_status",
    "data_status",
    "dataset_version",
    "coverage"
  ],
