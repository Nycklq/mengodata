Cobertura verificada = SELECTEDVALUE(Provenance[coverage_verified], FALSE())

Jogos = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, COUNTROWS(TeamMatches), BLANK())

Vitórias = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[wins]), BLANK())

Empates = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[draws]), BLANK())

Derrotas = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[losses]), BLANK())

Pontos = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[points]), BLANK())

Gols pró = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[goals_for]), BLANK())

Gols contra = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[goals_against]), BLANK())

Saldo = IF(NOT ISBLANK([Jogos]), [Gols pró] - [Gols contra], BLANK())

Aproveitamento (%) = DIVIDE([Pontos] * 100, [Jogos] * 3, BLANK())

Gols pró por jogo = DIVIDE([Gols pró], [Jogos], BLANK())

Gols contra por jogo = DIVIDE([Gols contra], [Jogos], BLANK())

Sem sofrer gol = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, SUM(TeamMatches[clean_sheets]), BLANK())

Pontos acumulados = CALCULATE([Pontos], FILTER(ALLSELECTED(Rounds[official_round]), Rounds[official_round] <= MAX(Rounds[official_round])))

Gols pró acumulados = CALCULATE([Gols pró], FILTER(ALLSELECTED(Rounds[official_round]), Rounds[official_round] <= MAX(Rounds[official_round])))

Gols contra acumulados = CALCULATE([Gols contra], FILTER(ALLSELECTED(Rounds[official_round]), Rounds[official_round] <= MAX(Rounds[official_round])))

Mediana de gols = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, MEDIAN(TeamMatches[goals_for]), BLANK())

Q1 de gols = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, PERCENTILE.INC(TeamMatches[goals_for], 0.25), BLANK())

Q3 de gols = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 0, PERCENTILE.INC(TeamMatches[goals_for], 0.75), BLANK())

Desvio populacional de gols = IF([Cobertura verificada] && COUNTROWS(TeamMatches) > 1, STDEV.P(TeamMatches[goals_for]), IF([Jogos] = 1, 0, BLANK()))

Pontos Flamengo = CALCULATE([Pontos], REMOVEFILTERS(Clubs), Clubs[club_id] = "club:flamengo")

Pontos clube comparado = IF(HASONEVALUE(ClubeComparado[club_id]), CALCULATE([Pontos], REMOVEFILTERS(Clubs), TREATAS(VALUES(ClubeComparado[club_id]), Clubs[club_id])), BLANK())

Posição calculada = IF(HASONEVALUE(Clubs[club_id]), CALCULATE(MAX(Standings[position]), FILTER(ALL(Rounds), Rounds[official_round] = MAX(Rounds[official_round]))), BLANK())
