  "components": {
    "schemas": {
      "AnalyticsEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "scope",
          "availability",
          "reason",
          "coverage",
          "dataset_version",
          "source"
        ],
        "properties": {
          "schema_version": { "const": 1 },
          "scope": {
            "const": {
              "competition_id": "competition:brasileirao-serie-a-men",
              "season": 2025,
              "team_id": "club:flamengo",
              "first_round": 1,
              "last_round": 38
            }
          },
          "availability": { "enum": ["unavailable", "partial", "available"] },
          "reason": { "type": ["string", "null"] },
          "coverage": { "type": ["object", "null"] },
          "dataset_version": { "type": ["string", "null"] },
          "source": { "type": ["object", "null"] },
          "data": {
            "description": "Objeto, lista ou null conforme o recurso. Valores desconhecidos permanecem null; listas vazias não representam zeros esportivos.",
            "type": ["object", "array", "null"]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code"],
            "properties": { "code": { "type": "string" } }
          }
        }
      }
    },
    "responses": {
      "InvalidQuery": {
        "description": "INVALID_QUERY: parâmetro, UUID, limite ou ordenação inválida.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "object",
                  "required": ["code"],
                  "properties": { "code": { "type": "string" } }
                }
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "RATE_LIMITED: máximo de 300 requisições por IP em 60 segundos, processo local.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "object",
                  "required": ["code"],
                  "properties": { "code": { "type": "string" } }
                }
              }
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": { "type": "integer" },
            "description": "Segundos até nova tentativa"
          }
        }
      },
      "InternalError": {
        "description": "INTERNAL_ERROR: falha interna sem exposição de detalhes.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "object",
                  "required": ["code"],
                  "properties": { "code": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
